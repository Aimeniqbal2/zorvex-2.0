# ==============================================================================
# Zorvex ERP 2.0 — Production Environment Template (.env)
# Copy this file to .env on the VPS: cp .env.prod.example .env
# Populate with strong production credentials. DO NOT commit actual secrets.
# ==============================================================================

# --- Django Security Configuration ---
DEBUG=False
SECRET_KEY=generate_a_strong_50_character_random_secret_key
# 32-byte URL-safe base64 key for EncryptedCharField (run: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FIELD_ENCRYPTION_KEY=

# Domains & Origins (Comma-separated, no spaces)
ALLOWED_HOSTS=client.domain.com,www.client.domain.com,127.0.0.1,localhost,web
CSRF_TRUSTED_ORIGINS=https://client.domain.com,https://www.client.domain.com
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://client.domain.com,https://www.client.domain.com

# --- PostgreSQL Container Database ---
DB_NAME=erp_prod_db
DB_USER=erp_user
DB_PASSWORD=generate_strong_database_password_here
DB_HOST=db
DB_PORT=5432

# --- Redis & Celery ---
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- SMTP / Email Configuration ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=postmaster@client.domain.com
EMAIL_HOST_PASSWORD=your_smtp_password_here
DEFAULT_FROM_EMAIL=noreply@client.domain.com
